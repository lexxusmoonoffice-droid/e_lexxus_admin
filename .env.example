# =====================================================================
# Lexxus — admin dashboard env
# Copy to .env.local for local dev. Never commit .env.local.
# =====================================================================

# Backend API base URL (include /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:5050/api

# Admin site URL — used for absolute links in emails/notifications.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Sentry — optional. See lib/sentry.ts for wiring.
NEXT_PUBLIC_SENTRY_DSN=
